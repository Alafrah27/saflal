# Public mobile configuration. Replace with your own service configuration.
# Never put a Clerk/Stream secret or Convex deployment key in EXPO_PUBLIC_*.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CONVEX_URL=
EXPO_PUBLIC_CONVEX_SITE_URL=
EXPO_PUBLIC_STREAM_ANDROID_PUSH_PROVIDER=

# Local Convex CLI deployment selector; not a deployment credential.
CONVEX_DEPLOYMENT=
