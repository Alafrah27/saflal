# EAS CLI 18 copies from the Git repository root, including on Windows.
# Keep these rules here; mobile/.easignore is not read for that copy.
# This file replaces nested .gitignore rules for EAS uploads only.

# The Android app does not need the separately deployed backend or admin app.
/backend
/admin

# Dependencies and generated Expo/native output (regenerated by EAS Prebuild).
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
/mobile/android
/mobile/ios
.gradle/
.kotlin/
app-example/

# Local credentials and environment files must not enter the build archive.
.env*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*firebase-adminsdk*.json
google-services.json

# Editor, compiler, and debug output.
.DS_Store
*.orig.*
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
*.tsbuildinfo

# Android client Firebase configuration is required by app.json.
# Keep it Git-ignored; this exception includes only the client config in EAS.
!/mobile/google-services.json
